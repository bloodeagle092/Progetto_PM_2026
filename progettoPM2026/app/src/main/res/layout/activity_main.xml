<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_restoup_screen"
    android:padding="24dp"
    tools:context=".MainActivity">

    <LinearLayout
        android:id="@+id/brand_lockup"
        android:layout_width="396dp"
        android:layout_height="102dp"
        android:layout_marginBottom="48dp"
        android:gravity="center"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/search_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.44"
        app:layout_constraintVertical_chainStyle="packed"
        app:layout_constraintWidth_max="360dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/brand_title_row"
            android:layout_width="match_parent"
            android:layout_height="74dp">

            <TextView
                android:id="@+id/brand_name_resto"
                android:layout_width="wrap_content"
                android:layout_height="74dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/brand_name_resto"
                android:textColor="@color/restoup_text_primary"
                android:textSize="64sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/brand_name_up"
                app:layout_constraintHorizontal_chainStyle="packed"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/brand_name_up"
                android:layout_width="wrap_content"
                android:layout_height="74dp"
                android:fontFamily="sans-serif-light"
                android:gravity="center"
                android:includeFontPadding="false"
                android:text="@string/brand_name_up"
                android:textColor="@color/restoup_gold"
                android:textSize="64sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/brand_name_resto"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/brand_name_dot"
                android:layout_width="wrap_content"
                android:layout_height="74dp"
                android:fontFamily="sans-serif-medium"
                android:gravity="top"
                android:includeFontPadding="false"
                android:paddingStart="4dp"
                android:paddingTop="4dp"
                android:text="@string/brand_dot"
                android:textColor="@color/restoup_accent_orange"
                android:textSize="31sp"
                app:layout_constraintStart_toEndOf="@id/brand_name_up"
                app:layout_constraintTop_toTopOf="@id/brand_name_up" />
        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:id="@+id/brand_tagline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans-serif"
            android:includeFontPadding="false"
            android:letterSpacing="0.18"
            android:text="@string/brand_tagline"
            android:textColor="@color/restoup_text_secondary"
            android:textSize="13sp" />
    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_button"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:text="@string/llm_search"
        android:textAllCaps="false"
        android:textColor="@color/restoup_text_on_gold"
        android:textSize="16sp"
        app:backgroundTint="@color/restoup_gold"
        app:cornerRadius="18dp"
        app:icon="@android:drawable/ic_menu_search"
        app:iconGravity="textStart"
        app:iconTint="@color/restoup_text_on_gold"
        app:layout_constraintBottom_toTopOf="@id/creator_button"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="320dp"
        app:layout_constraintTop_toBottomOf="@id/brand_lockup" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/creator_button"
        android:layout_width="0dp"
        android:layout_height="60dp"
        android:layout_marginTop="14dp"
        android:text="@string/json_creator"
        android:textAllCaps="false"
        android:textColor="@color/restoup_text_primary"
        android:textSize="16sp"
        app:backgroundTint="@color/restoup_surface_alt"
        app:cornerRadius="18dp"
        app:icon="@android:drawable/ic_menu_upload"
        app:iconGravity="textStart"
        app:iconTint="@color/restoup_gold"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_max="320dp"
        app:layout_constraintTop_toBottomOf="@id/search_button"
        app:strokeColor="@color/restoup_gold"
        app:strokeWidth="1dp" />

</androidx.constraintlayout.widget.ConstraintLayout>
