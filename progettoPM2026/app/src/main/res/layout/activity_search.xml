<?xml version="1.0" encoding="utf-8"?>

<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/chat_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#080223"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#080223"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="14dp"
        android:paddingEnd="12dp"
        android:paddingBottom="14dp">

        <!-- Back / close button — identical style to your converter -->
        <ImageButton
            android:id="@+id/buttonBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:padding="8dp"
            android:src="@android:drawable/ic_media_previous"
            app:tint="#FFFFFF" />

        <!-- Chat title / active model name, expands to fill remaining width -->
        <TextView
            android:id="@+id/textViewModelName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="Modello_che_utente_sta_usando"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/buttonNewChat"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="New chat"
            android:padding="8dp"
            android:src="@android:drawable/ic_input_add"
            app:tint="#D4AF37" />
    </LinearLayout>

    <!-- Thin gold divider under the top bar — decorative, matches your accent color -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#080223" />

    <!-- ══════════════════════════════════════════
         MESSAGE LIST AREA
         NestedScrollView with layout_weight="1" so it grows
         to fill all available vertical space between the top
         bar and the input bar — exactly like resultScrollArea
         in your converter.
         fillViewport="true" lets the inner LinearLayout
         stretch even when there are few messages.
    ══════════════════════════════════════════ -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/chatScrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="#101010"
        android:fillViewport="true"
        android:overScrollMode="ifContentScrolls"
        android:paddingTop="8dp"
        android:paddingBottom="8dp"
        android:clipToPadding="false">

        <!--
            This inner LinearLayout is where you will add
            message bubbles dynamically from Kotlin:
                val bubble = layoutInflater.inflate(R.layout.item_message_user, chatContainer, false)
                chatContainer.addView(bubble)
            orientation="vertical" stacks messages top-to-bottom.
        -->
        <LinearLayout
            android:id="@+id/chatContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp" />

    </androidx.core.widget.NestedScrollView>

    <!-- ══════════════════════════════════════════
         ERROR BANNER (hidden by default)
         Appears above the input bar when an API call fails.
         Same style as textViewError in your converter.
    ══════════════════════════════════════════ -->
    <TextView
        android:id="@+id/textViewError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#2B1515"
        android:padding="12dp"
        android:textColor="#080223"
        android:textSize="13sp"
        android:visibility="gone" />

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#2A2A2A" />

    <LinearLayout
        android:id="@+id/inputBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="#1A1A1A"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="12dp"
        android:paddingTop="10dp"
        android:paddingEnd="8dp"
        android:paddingBottom="10dp">

        <EditText
            android:id="@+id/editTextMessage"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@android:color/transparent"
            android:hint="Message <insert the model here>"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minLines="1"
            android:paddingStart="4dp"
            android:paddingEnd="8dp"
            android:textColor="#FFFFFF"
            android:textColorHint="#888888"
            android:textSize="15sp" />

        <ProgressBar
            android:id="@+id/progressBarTyping"
            style="?android:attr/progressBarStyleSmall"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginEnd="8dp"
            android:indeterminateTint="#D4AF37"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonSend"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:contentDescription="Send message"
            android:minWidth="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:text="Send"
            android:textAllCaps="false"
            android:textColor="#101010"
            android:textSize="14sp"
            app:backgroundTint="#D4AF37"
            app:cornerRadius="16dp"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="start"
            app:iconSize="18dp"
            app:iconTint="#101010" />

    </LinearLayout>

</LinearLayout>